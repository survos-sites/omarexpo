{
    "name": "survos-sites/omarexpo",
    "description": "Chiapas exposition for Omar",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-pdo_sqlite": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "ext-sqlite3": "*",
        "api-platform/doctrine-orm": "^4.1.7",
        "api-platform/symfony": "^4.1.7",
        "bizkit/versioning-bundle": "^1.2.1",
        "doctrine/dbal": "^4.2.3",
        "doctrine/doctrine-bundle": "^2.14.0",
        "doctrine/doctrine-migrations-bundle": "^3.4.1",
        "doctrine/orm": "^3.3.2",
        "easycorp/easyadmin-bundle": "^4.24.6",
        "endroid/qr-code-bundle": "^6.0",
        "friendsofsymfony/jsrouting-bundle": "^3.5.2",
        "inspector-apm/inspector-symfony": "^1.8.2",
        "league/csv": "^9.23",
        "league/flysystem-aws-s3-v3": "^3.29",
        "liip/imagine-bundle": ">=2.13.3",
        "nelmio/cors-bundle": "^2.5",
        "phpdocumentor/reflection-docblock": "^5.6.2",
        "phpstan/phpdoc-parser": "^2.1",
        "spomky-labs/pwa-bundle": "1.3.x",
        "survos/bootstrap-bundle": ">=1.5.529",
        "survos/command-bundle": ">=1.5.529",
        "survos/core-bundle": "^1.5.529",
        "survos/crawler-bundle": ">=1.5.529",
        "survos/flickr-bundle": ">=1.5.529",
        "survos/google-sheets-bundle": ">=1.5.529",
        "survos/js-twig-bundle": "dev-main",
        "survos/mobile-bundle": "dev-main",
        "survos/simple-datatables-bundle": "^1.5.529",
        "survos/storage-bundle": ">=1.5.529",
        "symfony/asset": "^7.2",
        "symfony/asset-mapper": "^7.2.5",
        "symfony/console": "^7.2.5",
        "symfony/doctrine-messenger": "^7.2.5",
        "symfony/dotenv": "^7.2",
        "symfony/expression-language": "^7.2",
        "symfony/flex": "^2.5.0",
        "symfony/form": "^7.2.5",
        "symfony/framework-bundle": "^7.2.5",
        "symfony/http-client": "^7.2.4",
        "symfony/intl": "^7.2",
        "symfony/mailer": "^7.2.3",
        "symfony/mime": "^7.2.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/notifier": "^7.2",
        "symfony/process": "^7.2.5",
        "symfony/property-access": "^7.2.3",
        "symfony/property-info": "^7.2.5",
        "symfony/runtime": "^7.2.3",
        "symfony/security-bundle": "^7.2.3",
        "symfony/serializer": "^7.2.5",
        "symfony/stimulus-bundle": "^2.24.0",
        "symfony/string": "^7.2",
        "symfony/translation": "^7.2.4",
        "symfony/twig-bundle": "^7.2",
        "symfony/ux-live-component": "^2.24",
        "symfony/ux-turbo": "^2.24",
        "symfony/ux-twig-component": ">=2.24.0",
        "symfony/validator": "^7.2.5",
        "symfony/web-link": "^7.2",
        "symfony/yaml": "^7.2.5",
        "symfonycasts/verify-email-bundle": ">=1.17.3",
        "twig/extra-bundle": "^2.12|^3.20",
        "twig/markdown-extra": "^3.20",
        "twig/twig": "^2.12|^3.20.0"
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": true,
            "php-http/discovery": true,
            "survos/installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "zenstruck/class-metadata": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "fos:js-routing:dump --format=js --target=public/js/fos_js_routes.js --callback=\"export default \"": "symfony-cmd"

        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "^7.3"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.22",
        "rector/rector": "^2.0.11",
        "survos/maker-bundle": "^1.5.503",
        "symfony/browser-kit": "^7.2.4",
        "symfony/css-selector": "^7.2",
        "symfony/debug-bundle": "^7.2",
        "symfony/maker-bundle": "^1.62.1",
        "symfony/phpunit-bridge": "^7.2",
        "symfony/stopwatch": "^7.2.4",
        "symfony/web-profiler-bundle": "^7.2.4"
    }
}
